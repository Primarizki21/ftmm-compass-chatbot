# FTMM COMPASS Chatbot - Environment Configuration
# Endpoint Ollama yang dihubungi oleh container (bridge ke host gateway WSL2)
OLLAMA_HOST=http://host.docker.internal:11434
PORT=8000
DEFAULT_LLM_MODEL=qwen2.5:3b
DEFAULT_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=2048

# Pinning OpenMP / BLAS threads di dalam container (mencegah CPU thread thrashing di WSL2)
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
MKL_NUM_THREADS=2
TOKENIZERS_PARALLELISM=false

# Rekomendasi variabel daemon Ollama di Host WSL2:
# OLLAMA_HOST=0.0.0.0:11434
# OLLAMA_KEEP_ALIVE=-1
# OLLAMA_MAX_LOADED_MODELS=2
# OLLAMA_NUM_PARALLEL=1
# OLLAMA_CONTEXT_LENGTH=2048
# OLLAMA_FLASH_ATTENTION=1
# OLLAMA_KV_CACHE_TYPE=q8_0
