# FTMM COMPASS Chatbot - Environment Configuration
# Service Endpoints & Dual-Backend Configuration
PORT=8000
LLM_BACKEND=ollama
LLM_MODEL_NAME=llama3.2:3b
BONSAI_HOST=http://127.0.0.1:8080
BONSAI_PORT=8080
OLLAMA_HOST=http://127.0.0.1:11434
EMBED_MODEL_NAME=nomic-embed-text-v2-moe
ENABLE_OLLAMA_FALLBACK=false

# Path binary llama-server & bobot model GGUF (Opsional, skrip otomatis mencari di ./bin/ dan ./models/)
# LLAMA_SERVER_BIN=./bin/llama-server
# MODEL_PATH=./models/Ternary-Bonsai-2-4B-PQ2_0.gguf
# CUDA_LIB_DIR=/home/primarizki/.local/lib/ollama/cuda_v12

# Backward-compatibility aliases
DEFAULT_LLM_MODEL=llama3.2:3b
DEFAULT_EMBED_MODEL=nomic-embed-text-v2-moe
OLLAMA_NUM_CTX=2048

# Pinning OpenMP / BLAS threads di dalam container (mencegah CPU thread thrashing di WSL2)
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
MKL_NUM_THREADS=2
TOKENIZERS_PARALLELISM=false

# Rekomendasi variabel daemon Ollama di Host WSL2:
# OLLAMA_HOST=0.0.0.0:11434
# OLLAMA_KEEP_ALIVE=-1
# OLLAMA_MAX_LOADED_MODELS=2
# OLLAMA_NUM_PARALLEL=1
# OLLAMA_CONTEXT_LENGTH=2048
# OLLAMA_FLASH_ATTENTION=1
# OLLAMA_KV_CACHE_TYPE=q8_0

# Session Persistence & Concurrency Throttle Configuration
SESSION_STORE_BACKEND=sqlite
SESSION_DB_PATH=data/sessions/sessions.db
MAX_CONCURRENT_INFERENCE=1
MAX_QUEUE_WAIT_SECONDS=10.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8001,http://localhost:3000
