# FTMM COMPASS Chatbot - Environment Configuration
# Salin berkas ini menjadi `.env` lalu isi NINE_ROUTER_API_KEY.
# Nama variabel di sini WAJIB identik dengan `.env` (lihat tabel di README).

# --- Generator (LLM) ---
# nine_router | ollama | bonsai
LLM_BACKEND=nine_router
# Wajib memakai prefix provider 9router (ag/gemini-...), tanpa prefix akan 404.
LLM_MODEL_NAME=ag/gemini-3.8-flash-low
# Base URL OpenAI-compatible 9router: lokal (http://127.0.0.1:20128) atau tunnel (https://<short-id>.abc-tunnel.us).
# Request dikirim ke <NINE_ROUTER_HOST>/v1/chat/completions.
NINE_ROUTER_HOST=https://<short-id>.abc-tunnel.us
# Wajib key terbitan dashboard 9router. Key Google Gemini ditolak 400 API_KEY_INVALID.
NINE_ROUTER_API_KEY=
ENABLE_OLLAMA_FALLBACK=false

# --- Embedding & daemon lokal ---
OLLAMA_HOST=http://127.0.0.1:11434
EMBED_MODEL_NAME=nomic-embed-text-v2-moe
EMBED_DIMENSION=768
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=256

# --- Session & HTTP API ---
SESSION_STORE_BACKEND=sqlite
SESSION_DB_PATH=data/sessions/sessions.db
MAX_CONCURRENT_INFERENCE=1
MAX_QUEUE_WAIT_SECONDS=10.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8001,http://localhost:3000

# --- Pinning thread CPU (WSL2) ---
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
MKL_NUM_THREADS=2
TOKENIZERS_PARALLELISM=false

# --- Opsional: backend Bonsai (llama-server lokal) ---
# BONSAI_HOST=http://127.0.0.1:8080
# BONSAI_PORT=8080
# LLAMA_SERVER_BIN=./bin/llama-server
# MODEL_PATH=./models/Ternary-Bonsai-2-4B-PQ2_0.gguf
# CUDA_LIB_DIR=/home/<user>/.local/lib/ollama/cuda_v12
