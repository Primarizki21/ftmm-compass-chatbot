# FTMM COMPASS Chatbot - Environment Configuration
# Endpoint Ollama yang dihubungi oleh backend/container
# Untuk Docker di WSL2/Linux, gunakan host.docker.internal agar container dapat memanggil daemon Ollama di host
OLLAMA_HOST=http://host.docker.internal:11434

# Port HTTP server untuk FastAPI Uvicorn
PORT=8000
